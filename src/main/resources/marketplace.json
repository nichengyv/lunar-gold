{
  "version": "1",
  "plugins": [
    {
      "id": "github",
      "name": "GitHub",
      "description": "管理 issue、PR、仓库，搜索代码与用户",
      "icon": "github",
      "category": "开发协作",
      "type": "MCP",
      "transport": "stdio",
      "command": "npx.cmd",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "runtime": ["node>=18"],
      "toolCount": 18,
      "requiredPermissions": ["发起到 api.github.com 的网络请求"],
      "credentials": [
        {
          "name": "GITHUB_TOKEN",
          "label": "GitHub Token",
          "description": "在 github.com/settings/tokens 创建，勾选 repo 权限",
          "required": true,
          "secret": true,
          "placeholder": "ghp_xxxxxxxxxxxx"
        }
      ],
      "homepageUrl": "https://github.com/modelcontextprotocol/servers/tree/main/src/github",
      "version": "1.0.0"
    },
    {
      "id": "fetch",
      "name": "Fetch",
      "description": "抓取并转换网页内容，供 AI 高效阅读",
      "icon": "globe",
      "category": "信息获取",
      "type": "MCP",
      "transport": "stdio",
      "command": "npx.cmd",
      "args": ["-y", "@modelcontextprotocol/server-fetch"],
      "runtime": ["node>=18"],
      "toolCount": 2,
      "requiredPermissions": ["访问你在对话中提供的任意网址"],
      "credentials": [],
      "homepageUrl": "https://github.com/modelcontextprotocol/servers/tree/main/src/fetch",
      "version": "1.0.0"
    },
    {
      "id": "filesystem",
      "name": "Filesystem",
      "description": "读写你授权的本地目录（仅能访问你指定的路径）",
      "icon": "folder",
      "category": "本地工具",
      "type": "MCP",
      "transport": "stdio",
      "command": "npx.cmd",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "${DIRECTORIES}"],
      "runtime": ["node>=18"],
      "toolCount": 6,
      "requiredPermissions": ["读写你指定的本地目录"],
      "credentials": [
        {
          "name": "DIRECTORIES",
          "label": "允许的目录",
          "description": "授权 AI 访问的目录，多个用英文逗号分隔",
          "required": true,
          "secret": false,
          "placeholder": "C:\\Users\\me\\docs, D:\\work"
        }
      ],
      "homepageUrl": "https://github.com/modelcontextprotocol/servers/tree/main/src/filesystem",
      "version": "1.0.0"
    },
    {
      "id": "git",
      "name": "Git",
      "description": "操作本地 Git 仓库：查看 diff、提交、分支等",
      "icon": "git-branch",
      "category": "开发协作",
      "type": "MCP",
      "transport": "stdio",
      "command": "npx.cmd",
      "args": ["-y", "@modelcontextprotocol/server-git", "${REPO_PATH}"],
      "runtime": ["node>=18"],
      "toolCount": 10,
      "requiredPermissions": ["操作你指定的本地 Git 仓库"],
      "credentials": [
        {
          "name": "REPO_PATH",
          "label": "仓库路径",
          "description": "本地 Git 仓库的绝对路径",
          "required": true,
          "secret": false,
          "placeholder": "D:\\my-project"
        }
      ],
      "homepageUrl": "https://github.com/modelcontextprotocol/servers/tree/main/src/git",
      "version": "1.0.0"
    },
    {
      "id": "playwright",
      "name": "Playwright",
      "description": "浏览器自动化：导航、点击、截图、提取页面内容",
      "icon": "chrome",
      "category": "本地工具",
      "type": "MCP",
      "transport": "stdio",
      "command": "npx.cmd",
      "args": ["-y", "@modelcontextprotocol/server-playwright"],
      "runtime": ["node>=18"],
      "toolCount": 15,
      "requiredPermissions": ["启动并控制本地浏览器"],
      "credentials": [],
      "homepageUrl": "https://github.com/modelcontextprotocol/servers/tree/main/src/playwright",
      "version": "1.0.0"
    },
    {
      "id": "everything",
      "name": "Everything",
      "description": "官方参考服务器：提供测试用的工具、资源与提示词，适合验证连接",
      "icon": "box",
      "category": "开发测试",
      "type": "MCP",
      "transport": "stdio",
      "command": "npx.cmd",
      "args": ["-y", "@modelcontextprotocol/server-everything"],
      "runtime": ["node>=18"],
      "toolCount": 8,
      "requiredPermissions": [],
      "credentials": [],
      "homepageUrl": "https://github.com/modelcontextprotocol/servers/tree/main/src/everything",
      "version": "1.0.0"
    }
  ]
}
