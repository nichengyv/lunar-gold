<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>
    <groupId>com.capsule</groupId>
    <artifactId>agent-gateway</artifactId>
    <version>1.0.0</version>
    <name>agent-gateway</name>
    <description>智能体安全网关</description>
    <properties>
        <java.version>21</java.version>
        <!-- Spring AI 版本由 BOM 统一下发，业务依赖不写版本号 -->
        <spring-ai.version>2.0.2</spring-ai.version>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Boot 4 的 JSON 自动配置默认是 Jackson 3（tools.jackson），只提供 Jackson 3 的 ObjectMapper。
             业务代码、jjwt 0.11、MCP SDK 都还在用 Jackson 2（com.fasterxml），
             不引这个模块时 ChatService 注入 ObjectMapper 会直接启动失败 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jackson2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- 邮件：注册验证码 / 找回密码。未配置 spring.mail.host 时降级为日志输出（见 MailConfig） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>
        <!-- Boot 4 把 Flyway 自动配置拆到了独立模块：只引 flyway-core 时
             FlywayAutoConfiguration 根本不加载，prod/desktop 启动会直接做 JPA 校验并报
             missing table。starter 会带上 spring-boot-flyway 自动配置与 flyway-core -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <!-- Flyway 10 起数据库支持按厂商拆分到独立模块，只引 flyway-core 时
             prod 启动会报 Unsupported Database: PostgreSQL（dev 因为关闭了 Flyway 从未暴露） -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- 指标输出为 Prometheus 文本格式：/actuator/prometheus 供采集端抓取 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- 接口文档：自动生成 OpenAPI 描述并提供 Swagger UI 交互页面 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <!-- Boot 4 使用 springdoc 3.x，与 Spring Framework 7 的 MVC API 对齐 -->
            <version>3.2.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <!-- PostgreSQL 驱动：统一数据库后业务表与向量表（pgvector）都在 PG -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 桌面端内嵌 PostgreSQL：由 DbLifecycleManager 在 desktop profile 下拉起本地库。
             PR-02 实测结论是内嵌 PG + pgvector，而不是 SQLite。
             只保留当前已验证的 Windows x64 二进制，排除 zonky 默认带入的 darwin/linux/alpine
             运行时；其他平台在 P2-08 按 OS/arch 补齐，不能直接把 Windows 结果外推。 -->
        <dependency>
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-postgres</artifactId>
            <version>2.2.2</version>
            <exclusions>
                <exclusion>
                    <groupId>io.zonky.test.postgres</groupId>
                    <artifactId>embedded-postgres-binaries-darwin-amd64</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.zonky.test.postgres</groupId>
                    <artifactId>embedded-postgres-binaries-linux-amd64</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.zonky.test.postgres</groupId>
                    <artifactId>embedded-postgres-binaries-linux-amd64-alpine</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- zonky 原始 Windows 二进制只用于测试与开发期兜底；发布包统一使用
             -Pwith-pg-runtime 内置的 pg-runtime.txz（含 pgvector）。
             用 test scope 而不是 provided：Spring Boot repackage 仍会把 provided
             打进 BOOT-INF/lib，只有 test scope 才彻底排除这 22 MB 重复运行时。 -->
        <dependency>
            <groupId>io.zonky.test.postgres</groupId>
            <artifactId>embedded-postgres-binaries-windows-amd64</artifactId>
            <version>16.11.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.11.5</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.11.5</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.11.5</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>4.12.0</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.17.2</version>
        </dependency>
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.1</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi</artifactId>
            <version>5.2.5</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.5</version>
        </dependency>
        <dependency>
            <!-- poi-scratchpad：支持旧版 .doc(HWPF) / .xls(HSSF) 等 OLE2 格式解析 -->
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-scratchpad</artifactId>
            <version>5.2.5</version>
        </dependency>
        <!-- Tika：按文件内容嗅探真实 MIME 类型，不信任用户给的扩展名，
             防止把 evil.exe 改名 evil.pdf 混进解析管线 -->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
            <version>3.2.2</version>
        </dependency>

        <!-- Spring AI：用 OpenAI 兼容协议接入 DeepSeek。
             第四十三批只引入依赖，通过 spring.ai.model.chat=none 暂不启用，
             等第四十四批做双轨桥接时再开 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
            <exclusions>
                <!-- 桌面端只走 HTTP/1.1 + HTTP/2，不使用 HTTP/3；
                     reactor-netty 默认带入的 QUIC 原生库（linux/osx/windows 共约 12 MB）、
                     macOS DNS resolver 与 Linux epoll 在 Windows 发布包里是死重量。
                     只排除原生库、保留 http3 编解码类，避免运行时类加载缺类。 -->
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-codec-native-quic</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-resolver-dns-native-macos</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-transport-native-epoll</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- 第五十一批：MCP 客户端。只做「工具发现 + 工具调用」，
             执行权仍由自研 ToolRegistry.dispatch 掌握，Spring AI 内部工具执行保持关闭 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-client</artifactId>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <!-- Boot 3.5 的 starter-parent 不再替 Lombok 配置注解处理器，
                 升级后 @Slf4j/@Data 生成的符号会全部"找不到"。
                 这里显式声明，保证 Maven 与 IDE 行为一致 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- 前端静态资源随 jar 分发（P3-01 前置）：
             先构建 frontend/dist，再执行 mvn -Pwith-frontend package，
             产物由后端直接托管，桌面壳只需加载 http://127.0.0.1:<port>/。
             不激活该 profile 时行为不变（dev/cloud 仍由 Vite 或 Nginx 托管）。 -->
        <profile>
            <id>with-frontend</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>copy-frontend-dist</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.basedir}/frontend/dist</directory>
                                            <filtering>false</filtering>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- 把含 pgvector 的 PostgreSQL 运行时打进 jar（P3-00 之后的自包含打包）：
             先执行 scripts/build-pg-runtime.ps1 产出 build/pg-runtime/pg-runtime.txz，
             再 mvn -Pwith-frontend,with-pg-runtime package。
             运行时按固定名读取 classpath:desktop/pg-runtime.txz，不再依赖 DESKTOP_PG_RUNTIME。 -->
        <profile>
            <id>with-pg-runtime</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>copy-pg-runtime</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.outputDirectory}/desktop</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.basedir}/build/pg-runtime</directory>
                                            <includes>
                                                <include>pg-runtime.txz</include>
                                            </includes>
                                            <filtering>false</filtering>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>