{
  "name": "agentkey-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "AgentKey Pro 桌面壳（Electron）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir --publish never --config.directories.output=../build/desktop-pack",
    "dist": "npm run pack && electron-builder --prepackaged ../build/desktop-pack/win-unpacked --publish never"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.agentkey.pro",
    "productName": "AgentKey Pro",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "../build/installer"
    },
    "files": [
      "main.js",
      "sidecar.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../target/agent-gateway-1.0.0.jar",
        "to": "sidecar/agent-gateway-1.0.0.jar"
      },
      {
        "from": "../build/desktop-runtime/jre",
        "to": "jre"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "AgentKey Pro",
      "deleteAppDataOnUninstall": false
    }
  }
}
