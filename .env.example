# 复制为 .env 后填写真实值；.env 已被 .gitignore 排除，切勿提交
# docker compose 会自动读取同目录下的 .env

# ---- 数据库（compose 首次启动时据此创建） ----
DB_PASSWORD=change-me-strong-password

# ---- 应用密钥（生产必须全部替换为随机值；缺失会导致启动失败） ----
# 生成示例：openssl rand -base64 48
JWT_SECRET=
# AES-256 主密钥，Base64 编码 32 字节：openssl rand -base64 32
AES_MASTER_KEY=
# RSA 密钥对（PEM 内容去掉头尾、换行合并为一行）
RSA_PRIVATE_KEY=
RSA_PUBLIC_KEY=

# ---- 第三方服务 ----
# Embedding 全局兜底密钥（SiliconFlow），用户也可在页面单独配置
EMBEDDING_API_KEY=
TAVILY_API_KEY=

# ---- 前端来源与 CSP ----
# 多个来源用英文逗号分隔
CORS_ORIGINS=http://localhost:8080
# 空格分隔的 URL 列表，需包含前端访问的后端地址与外部 LLM 域名
CSP_CONNECT_SRC=http://localhost:8080 https://api.deepseek.com https://api.tavily.com
